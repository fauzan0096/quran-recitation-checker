{
  "id": "bayyin",
  "name": "بيّن — Bayyin",
  "short_name": "بيّن",
  "description": "بيّن — Quran tilawat aya-ba-aya khud check karein, on-device, bina server. Duaein, tasbeeh, namaz ke auqaat aur qibla bhi.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "tabbed",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#f7f1e6",
  "theme_color": "#4b1b21",
  "categories": [
    "education",
    "books",
    "lifestyle"
  ],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "handle_links": "preferred",
  "icons": [
    {
      "src": "icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/shot-home-narrow.png",
      "sizes": "540x1080",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Home — Quran, duaein, tasbeeh"
    },
    {
      "src": "screenshots/shot-prayer-narrow.png",
      "sizes": "540x1080",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Namaz ke auqaat (awwal waqt)"
    },
    {
      "src": "screenshots/shot-dua-narrow.png",
      "sizes": "540x1080",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Masnoon duaein"
    },
    {
      "src": "screenshots/shot-home-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Home on desktop"
    },
    {
      "src": "screenshots/shot-daily-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Roz ka Noor on desktop"
    }
  ],
  "shortcuts": [
    {
      "name": "Duaein",
      "short_name": "Duaein",
      "description": "Duaein",
      "url": "./?go=dua",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Tasbeeh",
      "short_name": "Tasbeeh",
      "description": "Tasbeeh",
      "url": "./?go=tasbeeh",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Namaz ke auqaat",
      "short_name": "Namaz",
      "description": "Namaz ke auqaat",
      "url": "./?go=prayer",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Roz ki Naiki",
      "short_name": "Naiki",
      "description": "Roz ki Naiki",
      "url": "./?go=daily",
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "file_handlers": [
    {
      "action": "./?source=file",
      "accept": {
        "text/plain": [
          ".txt"
        ]
      },
      "icons": [
        {
          "src": "icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+bayyin",
      "url": "./?protocol=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 420
  },
  "note_taking": {
    "new_note_url": "./?go=daily&source=note"
  },
  "tab_strip": {
    "home_tab": "auto",
    "new_tab_button": {
      "url": "./"
    }
  },
  "widgets": [
    {
      "name": "Roz ka Noor",
      "short_name": "Noor",
      "description": "Aaj ki aya, hadith aur sunnah ka yaad-dehani card.",
      "tag": "bayyin-noor",
      "ms_ac_template": "widgets/noor-template.json",
      "data": "widgets/noor-data.json",
      "type": "application/json",
      "auth": false,
      "update": 86400,
      "screenshots": [
        {
          "src": "screenshots/widget-noor.png",
          "sizes": "600x400",
          "label": "Roz ka Noor widget"
        }
      ],
      "icons": [
        {
          "src": "icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ]
}